import 'reflect-metadata';
import ENTRY from '{{absoluteEntry}}';
import * as fs from '@open-norantec/toolchain/dist/lib/fs-extra';
import * as path from 'path';

async function bootstrap() {
    const absoluteOutputFilePath = path.resolve('{{config.workDir}}', '{{config.outputFilePath}}');
    await ENTRY?.options?.onBeforeBootstrap?.();

    try {
        fs.removeSync(absoluteOutputFilePath);
    } catch {}

    try {
        if (!fs.statSync(path.dirname(absoluteOutputFilePath)).isDirectory()) {
            fs.removeSync(path.dirname(absoluteOutputFilePath));
        }
        fs.mkdirpSync(path.dirname(absoluteOutputFilePath));
    } catch {}

    fs.writeFileSync(
        absoluteOutputFilePath,
        ENTRY?.generateSDKClientFileContent?.({
            Module: ENTRY?.options?.Module,
        }),
    );
}

bootstrap();
