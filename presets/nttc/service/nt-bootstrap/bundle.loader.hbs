import 'reflect-metadata';
import { NestFactory } from '@open-norantec/toolchain/dist/lib/@nestjs/core';
import cookieParser from '@open-norantec/toolchain/dist/lib/cookie-parser';
import { ModelUtil } from '@open-norantec/toolchain/dist/utilities/model-util.class';
import { LoggerService } from '@open-norantec/toolchain/dist/modules/logger/logger.service';
import { BasicExceptionsFilter } from '@open-norantec/toolchain/dist/filters/basic-exceptions.filter';
import ENTRY from '{{absoluteEntry}}';

async function bootstrap() {
    await ENTRY?.onBeforeBootstrap?.();

    const app = await NestFactory.create(ENTRY?.Module, {
        ...ENTRY?.factoryOptions,
    });

    if (ENTRY?.cors !== false) {
        app.enableCors({
            origin: '*',
            methods: '*',
            allowedHeaders: '*',
            credentials: false,
            ...(ENTRY?.cors ?? {}),
        });
    }

    app.use(cookieParser());

    if (Array.isArray(ENTRY?.globalFilters) && ENTRY?.globalFilters?.length > 0) {
        app.useGlobalFilters(ENTRY?.globalFilters);
    }

    if (Array.isArray(ENTRY?.globalGuards) && ENTRY?.globalGuards?.length > 0) {
        app.useGlobalFilters(ENTRY?.globalGuards);
    }

    if (Array.isArray(ENTRY?.globalInterceptors) && ENTRY?.globalInterceptors?.length > 0) {
        app.useGlobalFilters(ENTRY?.globalInterceptors);
    }

    if (Array.isArray(ENTRY?.globalPipes) && ENTRY?.globalPipes?.length > 0) {
        app.useGlobalFilters(ENTRY?.globalPipes);
    }

    if (!!ENTRY?.websocketAdapter) {
        app.useWebsocketAdapter(ENTRY?.useWebsocketAdapter);
    }

    if (Array.isArray(ENTRY?.uses)) {
        ENTRY.uses.forEach((middleware) => {
            app.use(middleware);
        });
    }

    const resolver = (Class) => app.resolve(Class);
    const listenPort = await ENTRY?.getListenPort?.(resolver);
    const loggerService = await app.resolve(LoggerService);
    const finalListenPort = listenPort > 0 ? listenPort : 8080;

    await ENTRY?.onBeforeListen?.(app);
    await app.listen(finalListenPort, () => {
        loggerService.log(`Listening on port: ${finalListenPort}`);
        ENTRY?.callback?.(resolver);
    });
}

bootstrap();
